---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const facts = await getCollection('facts');
const sorted = facts.sort((a, b) => a.id.localeCompare(b.id));
---

<Layout
  title="Patchward — facts"
  description="The canonical, dated claims ledger. Every number this site states is quoted from here."
>
  <section style="padding:64px 0;">
    <div style="font-family:'JetBrains Mono', monospace; font-size:12px; color:var(--text-secondary); text-transform:lowercase; margin-bottom:12px;">
      canonical claims ledger
    </div>
    <h1 style="font-size:36px; font-weight:700; margin-bottom:16px; max-width:600px;">/facts</h1>
    <p style="color:var(--text-secondary); font-size:16px; max-width:640px; margin-bottom:40px;">
      Every dated fact stated anywhere on this site is quoted from this file, not hand-copied
      per page. If a number here looks old, it's a bug — file it rather than trust it.
    </p>

    {sorted.map((fact) => (
      <div style="padding:20px 0; border-bottom:1px solid var(--hairline);">
        <div style="display:flex; align-items:baseline; justify-content:space-between; gap:16px; flex-wrap:wrap;">
          <span class="mono" style="font-weight:600; font-size:14px;">{fact.id}</span>
          <span class="mono" style="font-size:12px; color:var(--text-secondary);">
            verified {fact.data.verified.toISOString().slice(0, 10)}
          </span>
        </div>
        <p style="margin-top:8px; font-size:15px; line-height:1.6;">{fact.data.value}</p>
        <p class="mono" style="margin-top:6px; font-size:12px; color:var(--text-secondary);">source: {fact.data.source}</p>
      </div>
    ))}
  </section>
</Layout>
