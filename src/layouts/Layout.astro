---
interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
---

<!DOCTYPE html>
<html lang="en" data-mode="light">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link
    href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
    rel="stylesheet"
  />
  <style is:global>
    @import '../styles/tokens.css';

    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: var(--canvas);
      color: var(--ink);
      font-family: 'Inter', sans-serif;
      line-height: 1.55;
      transition: background 0.2s ease, color 0.2s ease;
    }
    .mono { font-family: 'JetBrains Mono', monospace; }
    .wrap { max-width: 960px; margin: 0 auto; padding: 0 24px; }
  </style>
</head>
<body>
  <div class="wrap">
    <header style="display:flex; align-items:center; justify-content:space-between; padding:24px 0; border-bottom:1px solid var(--hairline);">
      <a href="/" style="display:flex; align-items:center; gap:10px; font-family:'JetBrains Mono', monospace; font-weight:600; font-size:18px; color:var(--ink); text-decoration:none;">
        <span style="font-family:'JetBrains Mono', monospace; font-weight:500; font-size:20px; letter-spacing:-2px; color:var(--accent);">[/]</span>
        <span>patchward</span>
      </a>
      <button id="toggleMode" style="font-family:'JetBrains Mono', monospace; font-size:12px; padding:8px 14px; border:1px solid var(--hairline); background:transparent; color:var(--text-secondary); border-radius:4px; cursor:pointer;">dark mode</button>
    </header>

    <slot />

    <footer style="padding:48px 0; border-top:1px solid var(--hairline); font-size:13px; color:var(--text-secondary); display:flex; justify-content:space-between; flex-wrap:wrap; gap:16px;">
      <span>Patchward — local-first security agent</span>
      <span>
        <a href="/limits" style="color:var(--link); text-decoration:none;">/limits</a> ·
        <a href="/facts" style="color:var(--link); text-decoration:none;">/facts</a> ·
        <a href="mailto:yehor@callmedai.com" style="color:var(--link); text-decoration:none;">yehor@callmedai.com</a>
      </span>
    </footer>
  </div>

  <script>
    const root = document.documentElement;
    const btn = document.getElementById('toggleMode');
    btn?.addEventListener('click', () => {
      const isDark = root.getAttribute('data-mode') === 'dark';
      root.setAttribute('data-mode', isDark ? 'light' : 'dark');
      if (btn) btn.textContent = isDark ? 'dark mode' : 'light mode';
    });
  </script>
</body>
</html>
